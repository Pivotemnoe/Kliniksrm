# Browser-visible settings only. Never put the gateway sync secret in a VITE variable.
VITE_PUBLIC_GATEWAY_URL=
# Enable only after the gateway reverse proxy and approved privacy notice are ready.
VITE_INQUIRIES_ENABLED=false
VITE_SITE_PUBLIC_RELEASE=false
VITE_SITE_PRIVACY_URL=
# Build settings. Review builds remain excluded from indexing by default.
SITE_ORIGIN=https://clinic.temichevvet.ru
SITE_INDEXABLE=false
