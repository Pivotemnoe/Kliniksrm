# Existing platform URL/secret and current MAX bot stay in the server secret store.
OWNER_GATEWAY_URL=
OWNER_GATEWAY_PUBLIC_URL=
OWNER_GATEWAY_SYNC_SECRET=

# Both clinical API and owner gateway; independent of GROOMING.
PET_HOTEL_CRM_SYNC_ENABLED=false

# Gateway: browser draft requests may come only from the public hotel site.
PET_HOTEL_SITE_ORIGINS=https://pet.temichevvet.ru

# Gateway: enable only in the coordinated release, never with a QA transport.
# Same existing MAX_BOT_TOKEN; no new bot/token is required.
PET_HOTEL_CLIENT_NOTIFICATIONS_ENABLED=false
PET_HOTEL_NOTIFICATION_DAILY_LIMIT=10
