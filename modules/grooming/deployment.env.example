# CRM and gateway: same strong server-side synchronization secret, never in browser.
GROOMING_CRM_SYNC_ENABLED=false
OWNER_GATEWAY_URL=
OWNER_GATEWAY_PUBLIC_URL=
OWNER_GATEWAY_SYNC_SECRET=
# Optional separate signing secret (at least 24 random characters).
# Empty uses OWNER_GATEWAY_SYNC_SECRET.
GROOMING_BOOKING_SIGNING_SECRET=
# Gateway: sends through the existing MAX_BOT_TOKEN after real delivery acceptance.
GROOMING_CLIENT_NOTIFICATIONS_ENABLED=false
# Grooming transactions have their own budget, separate from clinical notifications.
GROOMING_NOTIFICATION_DAILY_LIMIT=10
# CRM API only: employee Web Push. Generate a persistent VAPID key pair before release.
# These keys are independent of MAX and of the owner gateway push keys.
GROOMING_STAFF_PUSH_ENABLED=false
GROOMING_STAFF_VAPID_SUBJECT=
GROOMING_STAFF_VAPID_PUBLIC_KEY=
GROOMING_STAFF_VAPID_PRIVATE_KEY=
MAX_BOT_USERNAME=
# Already configured current bot secrets stay in the server secret store:
# MAX_BOT_TOKEN, MAX_WEBHOOK_SECRET. Do not copy real values into this file.
# Standalone API/web are optional; integrated CRM uses the existing application.
GROOMING_API_PORT=4242
# Match deployed HTTPS staff origin; standard platform session settings also apply.
# APP_URL=https://staff.example.org

# Historical desired-time intake, separate from confirmed self-booking above.
GROOMING_BOOKING_ENABLED=false
GROOMING_QA_MODE=false
GROOMING_SITE_ORIGINS=https://pet.temichevvet.ru
GROOMING_PRIVACY_URL=
GROOMING_PRIVACY_VERSION=
# Optional separate bot. Empty means reuse the configured MAX_BOT_TOKEN.
GROOMING_MAX_BOT_TOKEN=
# Comma-separated explicit recipients. No recipients are inferred from clinical data.
GROOMING_MAX_RECIPIENT_IDS=
