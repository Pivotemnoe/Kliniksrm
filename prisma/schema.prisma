}

model DocumentTemplateCategory {
  id        String             @id @default(uuid())
  title     String             @unique
  templates DocumentTemplate[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model DocumentTemplate {
  id                 String                    @id @default(uuid())
  categoryId         String?
  category           DocumentTemplateCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title              String
  body               String?
  variables          Json?
  currentVersion     Int                       @default(1)
  versions           DocumentTemplateVersion[]
  visitDocuments     VisitDocument[]
  generatedDocuments GeneratedDocument[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([title])
}

model DocumentTemplateVersion {
  id                 String              @id @default(uuid())
  templateId         String
  template           DocumentTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version            Int
  categoryTitle      String?
  title              String
  body               String?
  variables          Json?
  createdById        String?
  createdByName      String?
  publishedAt        DateTime            @default(now())
  visitDocuments     VisitDocument[]
  generatedDocuments GeneratedDocument[]
  createdAt          DateTime            @default(now())

  @@unique([templateId, version])
  @@index([templateId, publishedAt])
}

model GeneratedDocument {
  id                String                   @id @default(uuid())
  templateId        String?
  template          DocumentTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersionId String?
  templateVersion   DocumentTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  visitDocumentId   String?                  @unique
  visitDocument     VisitDocument?           @relation(fields: [visitDocumentId], references: [id], onDelete: SetNull)
  fileId            String?
  file              FileObject?              @relation(fields: [fileId], references: [id], onDelete: SetNull)
  title             String
  status            DocumentStatus           @default(GENERATED)
  snapshot          Json?
  contentSha256     String?
  pdfSha256         String?
  generatedById     String?
  generatedByName   String?
  generatedAt       DateTime?
  signedById        String?
  signedByName      String?
  signedAt          DateTime?
  signatureMethod   DocumentSignatureMethod?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([templateVersionId])
  @@index([contentSha256])
}

model DocumentEvent {
  id              String            @id @default(uuid())
  visitDocumentId String
  visitDocument   VisitDocument     @relation(fields: [visitDocumentId], references: [id], onDelete: Cascade)
  type            DocumentEventType
  actorId         String?
  actorName       String?
  channel         String?
  details         Json?
  createdAt       DateTime          @default(now())

  @@index([visitDocumentId, createdAt])
  @@index([type, createdAt])
}

model NotificationTemplate {
  id        String               @id @default(uuid())
  channel   String
  eventCode String
  title     String
  subject   String?
  body      String
  variables Json?
  isActive  Boolean              @default(true)
  messages  NotificationOutbox[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([channel, eventCode])
  @@index([isActive])
}

model TemplateVariable {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FileObject {
  id                    String               @id @default(uuid())
  ownerId               String?
  owner                 Owner?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  animalId              String?
  animal                Animal?              @relation(fields: [animalId], references: [id], onDelete: SetNull)
  visitId               String?
  visit                 Visit?               @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitDocumentId       String?
  visitDocument         VisitDocument?       @relation(fields: [visitDocumentId], references: [id], onDelete: SetNull)
  laboratoryOrderId     String?
  laboratoryOrder       LaboratoryOrder?     @relation(fields: [laboratoryOrderId], references: [id], onDelete: SetNull)
  laboratoryOrderItemId String?
  laboratoryOrderItem   LaboratoryOrderItem? @relation(fields: [laboratoryOrderItemId], references: [id], onDelete: SetNull)
  supplyInvoiceId       String?
  supplyInvoice         SupplyInvoice?       @relation(fields: [supplyInvoiceId], references: [id], onDelete: SetNull)
  uploadedById          String?
  uploadedBy            Employee?            @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  purpose               FilePurpose          @default(MEDICAL_DOCUMENT)
  storageKey            String               @unique
  originalName          String
  mimeType              String?
  sizeBytes             Int?
  checksumSha256        String?
  visibility            FileVisibility       @default(PRIVATE)
  deletedAt             DateTime?
  generatedDocuments    GeneratedDocument[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([visitId])
  @@index([ownerId])
  @@index([animalId])
  @@index([visitDocumentId])
  @@index([laboratoryOrderId])
  @@index([laboratoryOrderItemId])
  @@index([supplyInvoiceId])
  @@index([uploadedById])
  @@index([purpose, createdAt])
  @@index([deletedAt])
}

model BackupJob {
  id         String    @id @default(uuid())
  status     JobStatus @default(PENDING)
  storageKey String?
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model BackgroundJob {
  id        String    @id @default(uuid())
  queueName String
  jobName   String
  status    JobStatus @default(PENDING)
  payload   Json?
  result    Json?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([queueName, status])
}

model DataTransferBatch {
  id               String                     @id @default(uuid())
  sourceSystem     String
  kind             String
  originalFileName String?
  fileChecksum     String
  status           DataTransferStatus         @default(DRAFT)
  totalRows        Int                        @default(0)
  readyRows        Int                        @default(0)
  importedRows     Int                        @default(0)
  skippedRows      Int                        @default(0)
  failedRows       Int                        @default(0)
  createdById      String?
  createdBy        Employee?                  @relation("DataTransferCreator", fields: [createdById], references: [id], onDelete: SetNull)
  startedAt        DateTime?
  completedAt      DateTime?
  rolledBackAt     DateTime?
  errorSummary     String?
  metadata         Json?
  rows             DataTransferRow[]
  fieldMappings    DataTransferFieldMapping[]
  entityLinks      DataTransferEntityLink[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([sourceSystem, kind, fileChecksum])
  @@index([status, createdAt])
  @@index([createdById])
}

model DataTransferRow {
  id             String                   @id @default(uuid())
  batchId        String
  batch          DataTransferBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber      Int
  sourceId       String?
  fingerprint    String
  status         DataTransferRowStatus    @default(PENDING)
  rawData        Json
  normalizedData Json?
  result         Json?
  error          String?
  entityLinks    DataTransferEntityLink[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([fingerprint])
}

model DataTransferFieldMapping {
  id           String            @id @default(uuid())
  batchId      String
  batch        DataTransferBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceColumn String
  targetField  String
  transform    String?
  required     Boolean           @default(false)
  createdAt    DateTime          @default(now())

  @@unique([batchId, sourceColumn])
  @@index([batchId, targetField])
}

model DataTransferEntityLink {
  id               String             @id @default(uuid())
  batchId          String
  batch            DataTransferBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowId            String?
  row              DataTransferRow?   @relation(fields: [rowId], references: [id], onDelete: SetNull)
  sourceEntityType String
  sourceEntityId   String?
  targetEntityType String
  targetEntityId   String
  action           DataTransferAction
  rollbackEligible Boolean            @default(false)
  rolledBackAt     DateTime?
  createdAt        DateTime           @default(now())

  @@index([batchId, action])
  @@index([rowId])
  @@index([targetEntityType, targetEntityId])
  @@index([sourceEntityType, sourceEntityId])
}
