generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  BLOCKED
}

enum AnimalSex {
  MALE
  FEMALE
  UNKNOWN
}

enum QueueUrgency {
  PLANNED
  URGENT
}

enum QueueStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  PLANNED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VisitStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HospitalStayStatus {
  ACTIVE
  DISCHARGED
  CANCELLED
}

enum HospitalRecordStatus {
  PLANNED
  COMPLETED
  SKIPPED
  AMENDMENT
}

enum VisitType {
  PRIMARY
  FOLLOW_UP
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
  ARCHIVED
}

enum NotificationChannel {
  INTERNAL
  MESSENGER
  TELEGRAM
  MAX
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum ClientPortalStatus {
  DISABLED
  ENABLED
  INVITED
  BLOCKED
}

enum LaboratoryOrderStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LaboratoryOrderItemStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  CANCELLED
}

enum PaymentType {
  CASH
  CARD
  BANK_TRANSFER
  DEPOSIT
  OTHER
}

enum BusinessCategoryType {
  INCOME
  EXPENSE
}

enum BusinessEntrySource {
  MANUAL
  UNRECORDED_REVENUE
  DAILY_DIFFERENCE
  PAYROLL_PAYOUT
  OWNER_OPERATION
}

enum BusinessEntryStatus {
  ACTIVE
  VOIDED
}

enum BusinessDailyCloseStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum BillSource {
  VISIT
  SALE
  MANUAL
}

enum OnlineRequestStatus {
  NEW
  IN_REVIEW
  ACCEPTED
  CANCELLED
  ARCHIVED
}

enum StockMovementType {
  SUPPLY
  SALE
  VISIT_USAGE
  WRITE_OFF
  TRANSFER
  CORRECTION
  SUPPLIER_RETURN
  INVENTORY
  RESORTING
}

enum PayrollPeriodStatus {
  DRAFT
  APPROVED
}

enum StockDocumentType {
  INVENTORY
  TRANSFER
  SUPPLIER_RETURN
  WRITE_OFF
  RESORTING
  CORRECTION
}

enum StockDocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum DocumentStatus {
  DRAFT
  GENERATED
  SIGNED
  CANCELLED
}

enum DocumentEventType {
  CREATED
  GENERATED
  SIGNED
  CANCELLED
  DELIVERY_QUEUED
  PRINTED
}

enum DocumentSignatureMethod {
  PAPER
  ELECTRONIC
  STATUS_CONFIRMATION
}

enum FileVisibility {
  PRIVATE
  INTERNAL
  PUBLIC_LINK
}

enum FilePurpose {
  MEDICAL_DOCUMENT
  LABORATORY_RESULT
  SUPPLY_DOCUMENT
}

enum ProductBarcodeType {
  EAN13
  GTIN
  INTERNAL
  SUPPLIER
  OTHER
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum DataTransferStatus {
  DRAFT
  PREVIEWED
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  ROLLING_BACK
  ROLLED_BACK
  ROLLBACK_BLOCKED
  FAILED
}

enum DataTransferRowStatus {
  PENDING
  READY
  SKIPPED
  IMPORTED
  FAILED
  ROLLED_BACK
}

enum DataTransferAction {
  CREATED
  MATCHED
}

enum NewsPriority {
  INFO
  IMPORTANT
  CRITICAL
}

enum PermissionEffect {
  GRANT
  DENY
}

enum MedicalPhraseSource {
  SYSTEM
  EMPLOYEE
  DIAGNOSIS_TEMPLATE
}

enum SupportRequestStatus {
  NEW
  IN_PROGRESS
  WAITING_CLINIC
  RESOLVED
  CLOSED
}

enum SupportRequestPriority {
  NORMAL
  HIGH
  CRITICAL
}

enum ClinicLicenseStatus {
  COMPATIBILITY
  UNLICENSED
  VALID
  EXPIRED
  INVALID
  MISMATCH
}

enum ServerAcceptanceStatus {
  PREPARED
  VERIFIED
  ACCEPTED
  REJECTED
}

enum SessionAccessType {
  LOCAL
  REMOTE
}

model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  phone           String?   @unique @db.VarChar(32)
  phoneNormalized String?   @db.VarChar(16)
  passwordHash    String
  employee        Employee?
  sessions        Session[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([phoneNormalized])
}

model Employee {
  id                        String                       @id @default(uuid())
  userId                    String?                      @unique
  user                      User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName                  String
  phone                     String?                      @db.VarChar(32)
  position                  String?
  defaultRoute              String?
  restrictLoginToShifts     Boolean                      @default(false)
  status                    EmployeeStatus               @default(ACTIVE)
  roles                     EmployeeRole[]
  permissionOverrides       EmployeePermissionOverride[]
  warehouseAccesses         EmployeeWarehouseAccess[]
  shifts                    EmployeeShift[]
  queueEntries              QueueEntry[]
  appointments              Appointment[]
  visits                    Visit[]
  hospitalStays             HospitalStay[]
  hospitalRecords           HospitalRecord[]             @relation("HospitalRecordAuthor")
  hospitalPlans             HospitalTreatmentPlan[]      @relation("HospitalTreatmentPlanAuthor")
  assignedTasks             Task[]                       @relation("TaskAssignee")
  createdTasks              Task[]                       @relation("TaskCreator")
  createdNotifications      NotificationOutbox[]         @relation("NotificationCreator")
  createdNewsPosts          NewsPost[]                   @relation("NewsPostCreator")
  newsReads                 NewsPostRead[]
  auditLogs                 AuditLog[]                   @relation("AuditActor")
  payments                  Payment[]
  createdSales              Sale[]                       @relation("SaleEmployee")
  payrollProfile            PayrollProfile?
  payrollEntries            PayrollEntry[]
  payrollAdjustments        PayrollAdjustment[]          @relation("PayrollAdjustmentEmployee")
  createdPayrollPeriods     PayrollPeriod[]              @relation("PayrollPeriodCreator")
  approvedPayrollPeriods    PayrollPeriod[]              @relation("PayrollPeriodApprover")
  createdPayrollAdjustments PayrollAdjustment[]          @relation("PayrollAdjustmentCreator")
  createdStockDocuments     StockDocument[]              @relation("StockDocumentCreator")
  postedStockDocuments      StockDocument[]              @relation("StockDocumentPoster")
  supplierPayments          SupplierPayment[]            @relation("SupplierPaymentCreator")
  createdBusinessEntries    BusinessEntry[]              @relation("BusinessEntryCreator")
  voidedBusinessEntries     BusinessEntry[]              @relation("BusinessEntryVoider")
  resolvedBusinessEntries   BusinessEntry[]              @relation("BusinessEntryResolver")
  createdBusinessCloses     BusinessDailyClose[]         @relation("BusinessDailyCloseCreator")
  submittedBusinessCloses   BusinessDailyClose[]         @relation("BusinessDailyCloseSubmitter")
  approvedBusinessCloses    BusinessDailyClose[]         @relation("BusinessDailyCloseApprover")
  medicalPhrases            MedicalPhrase[]
  dataTransferBatches       DataTransferBatch[]          @relation("DataTransferCreator")
  createdSupportRequests    SupportRequest[]             @relation("SupportRequestCreator")
  handledSupportRequests    SupportRequest[]             @relation("SupportRequestHandler")
  preparedAcceptances       ServerAcceptance[]           @relation("ServerAcceptancePreparer")
  acceptedAcceptances       ServerAcceptance[]           @relation("ServerAcceptanceAcceptor")
  uploadedFiles             FileObject[]                 @relation("FileUploader")
  remoteAccessInvitations   RemoteAccessInvitation[]     @relation("RemoteAccessInvitationEmployee")
  createdRemoteInvitations  RemoteAccessInvitation[]     @relation("RemoteAccessInvitationCreator")
  remoteAccessDevices       RemoteAccessDevice[]
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt

  @@index([fullName])
  @@index([phone])
}

model EmployeeShift {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  comment    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId, startsAt])
  @@index([startsAt, endsAt])
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  title       String
  description String?
  employees   EmployeeRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id                String                       @id @default(uuid())
  code              String                       @unique
  title             String
  description       String?
  roles             RolePermission[]
  employeeOverrides EmployeePermissionOverride[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
}

model EmployeeRole {
  employeeId String
  roleId     String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([employeeId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model EmployeePermissionOverride {
  employeeId   String
  permissionId String
  effect       PermissionEffect
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@id([employeeId, permissionId])
  @@index([permissionId])
}

model Session {
  id             String              @id @default(uuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessType     SessionAccessType   @default(LOCAL)
  remoteDeviceId String?
  remoteDevice   RemoteAccessDevice? @relation(fields: [remoteDeviceId], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime            @default(now())

  @@index([userId])
  @@index([remoteDeviceId])
  @@index([expiresAt])
}

model AuditLog {
  id         String    @id @default(uuid())
  actorId    String?
  actor      Employee? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Organization {
  id                  String                   @id @default(uuid())
  displayName         String
  legalName           String?
  orgType             String?
  inn                 String?
  kpp                 String?
  legalAddress        String?
  postalAddress       String?
  bankName            String?
  bik                 String?
  account             String?
  corrAccount         String?
  defaultBillDueDays  Int?
  logoStorageKey      String?
  logoOriginalName    String?
  logoMimeType        String?
  logoSizeBytes       Int?
  logoUpdatedAt       DateTime?
  offices             ClinicOffice[]
  businessDailyCloses BusinessDailyClose[]
  installation        ClinicInstallation?
  remoteAccessPolicy  RemoteAccessPolicy?
  remoteInvitations   RemoteAccessInvitation[]
  remoteDevices       RemoteAccessDevice[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model RemoteAccessPolicy {
  id                   String       @id @default(uuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled              Boolean      @default(false)
  requireTrustedDevice Boolean      @default(true)
  enrollmentTtlMinutes Int          @default(10)
  idleTimeoutMinutes   Int          @default(15)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model RemoteAccessInvitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation("RemoteAccessInvitationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      Employee?    @relation("RemoteAccessInvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tokenHash      String       @unique
  deviceName     String?
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([employeeId, createdAt])
  @@index([expiresAt])
}

model RemoteAccessDevice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  name           String
  userAgent      String?
  lastIpAddress  String?
  lastSeenAt     DateTime?
  trustedAt      DateTime     @default(now())
  revokedAt      DateTime?
  sessions       Session[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, revokedAt])
  @@index([employeeId, revokedAt])
  @@index([lastSeenAt])
}

model ClinicInstallation {
  id                String              @id @default(uuid())
  installationId    String              @unique @default(uuid())
  organizationId    String?             @unique
  organization      Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  licenseId         String?
  licenseCustomer   String?
  licensePayload    Json?
  licenseSignature  String?
  licenseStatus     ClinicLicenseStatus @default(COMPATIBILITY)
  licenseValidUntil DateTime?
  licenseCheckedAt  DateTime?
  licenseMessage    String?
  supportRequests   SupportRequest[]
  serverAcceptances ServerAcceptance[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([licenseStatus])
  @@index([licenseValidUntil])
}

model SupportRequest {
  id                  String                 @id @default(uuid())
  installationId      String
  installation        ClinicInstallation     @relation(fields: [installationId], references: [id], onDelete: Restrict)
  createdById         String?
  createdBy           Employee?              @relation("SupportRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  handledById         String?
  handledBy           Employee?              @relation("SupportRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)
  status              SupportRequestStatus   @default(NEW)
  priority            SupportRequestPriority @default(NORMAL)
  subject             String
  message             String
  contact             String?
  diagnosticConsentAt DateTime?
  diagnosticSnapshot  Json?
  diagnosticSha256    String?
  externalReference   String?
  response            String?
  resolvedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([installationId, status, createdAt])
  @@index([createdById, createdAt])
}

model ServerAcceptance {
  id                 String                 @id @default(uuid())
  installationId     String
  installation       ClinicInstallation     @relation(fields: [installationId], references: [id], onDelete: Restrict)
  preparedById       String?
  preparedBy         Employee?              @relation("ServerAcceptancePreparer", fields: [preparedById], references: [id], onDelete: SetNull)
  acceptedById       String?
  acceptedBy         Employee?              @relation("ServerAcceptanceAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  status             ServerAcceptanceStatus @default(PREPARED)
  releaseVersion     String
  releaseRevision    String?
  sourceServer       String?
  targetServer       String?
  archiveName        String
  archiveSha256      String
  sourceCounts       Json
  targetCounts       Json?
  verificationReport Json
  notes              String?
  acceptedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([installationId, status, createdAt])
  @@index([archiveSha256])
}

model ClinicOffice {
  id                  String               @id @default(uuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  phone               String?              @db.VarChar(32)
  timezone            String               @default("Europe/Moscow")
  address             String?
  workingHours        Json?
  rooms               Room[]
  warehouses          Warehouse[]
  hospitalBoxes       HospitalBox[]
  cashboxes           Cashbox[]
  owners              Owner[]
  appointments        Appointment[]
  queueEntries        QueueEntry[]
  businessEntries     BusinessEntry[]
  businessDailyCloses BusinessDailyClose[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Room {
  id           String        @id @default(uuid())
  officeId     String
  office       ClinicOffice  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name         String
  queueEntries QueueEntry[]
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([officeId, name])
}

model Warehouse {
  id                String                    @id @default(uuid())
  officeId          String
  office            ClinicOffice              @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name              String
  employeeAccesses  EmployeeWarehouseAccess[]
  batches           StockBatch[]
  supplyItems       SupplyInvoiceItem[]
  stockMovements    StockMovement[]           @relation("MovementWarehouse")
  incomingMovements StockMovement[]           @relation("MovementToWarehouse")
  stockDocuments    StockDocument[]           @relation("StockDocumentWarehouse")
  incomingDocuments StockDocument[]           @relation("StockDocumentToWarehouse")
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([officeId, name])
}

model EmployeeWarehouseAccess {
  employeeId  String
  warehouseId String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([employeeId, warehouseId])
  @@index([warehouseId])
}

model HospitalBox {
  id        String         @id @default(uuid())
  officeId  String
  office    ClinicOffice   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name      String
  visits    Visit[]
  stays     HospitalStay[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([officeId, name])
}

model PaymentMethod {
  id                      String                   @id @default(uuid())
  title                   String
  type                    PaymentType
  isActive                Boolean                  @default(true)
  sortOrder               Int                      @default(0)
  payments                Payment[]
  businessEntries         BusinessEntry[]
  businessDailyCloseLines BusinessDailyCloseLine[]
  supplierPayments        SupplierPayment[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([title])
  @@index([isActive, sortOrder])
}

model Cashbox {
  id                      String                   @id @default(uuid())
  officeId                String?
  office                  ClinicOffice?            @relation(fields: [officeId], references: [id], onDelete: SetNull)
  title                   String
  fiscalNumber            String?
  isActive                Boolean                  @default(true)
  payments                Payment[]
  businessEntries         BusinessEntry[]
  businessDailyCloseLines BusinessDailyCloseLine[]
  supplierPayments        SupplierPayment[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([officeId, title])
  @@index([isActive])
}

model Owner {
  id                           String                     @id @default(uuid())
  officeId                     String?
  office                       ClinicOffice?              @relation(fields: [officeId], references: [id], onDelete: SetNull)
  fullName                     String
  fullNameNormalized           String?                    @db.VarChar(240)
  organizationName             String?
  phone                        String?                    @db.VarChar(32)
  phoneNormalized              String?                    @db.VarChar(16)
  extraPhone                   String?                    @db.VarChar(32)
  email                        String?
  address                      String?
  source                       String?
  passportData                 String?
  comment                      String?
  preferredNotificationChannel NotificationChannel?
  telegramChatId               String?
  maxUserId                    String?
  allowSms                     Boolean                    @default(false)
  allowTelegram                Boolean                    @default(false)
  allowMax                     Boolean                    @default(false)
  allowEmail                   Boolean                    @default(false)
  portalAccess                 ClientPortalAccess?
  goodsDiscount                Decimal                    @default(0) @db.Decimal(5, 2)
  servicesDiscount             Decimal                    @default(0) @db.Decimal(5, 2)
  balance                      Decimal                    @default(0) @db.Decimal(12, 2)
  animals                      Animal[]
  trustedPeople                TrustedPerson[]
  queueEntries                 QueueEntry[]
  appointments                 Appointment[]
  visits                       Visit[]
  hospitalStays                HospitalStay[]
  tasks                        Task[]
  bills                        Bill[]
  sales                        Sale[]
  balanceOperations            OwnerBalanceOperation[]
  notifications                NotificationOutbox[]
  onlineRequests               OnlineAppointmentRequest[]
  files                        FileObject[]
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt

  @@index([fullName])
  @@index([phone])
  @@index([phoneNormalized])
  @@index([fullNameNormalized, phoneNormalized])
  @@index([email])
}

model ClientPortalAccess {
  id                 String             @id @default(uuid())
  ownerId            String             @unique
  owner              Owner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status             ClientPortalStatus @default(DISABLED)
  inviteTokenHash    String?
  inviteExpiresAt    DateTime?
  invitedAt          DateTime?
  lastLoginAt        DateTime?
  loginCodeHash      String?
  loginCodeExpiresAt DateTime?
  loginCodeAttempts  Int                @default(0)
  blockedReason      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
  @@index([loginCodeExpiresAt])
}

model TrustedPerson {
  id        String   @id @default(uuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String?  @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Animal {
  id             String                     @id @default(uuid())
  ownerId        String
  owner          Owner                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  nickname       String
  species        String?
  breed          String?
  sex            AnimalSex                  @default(UNKNOWN)
  birthDate      DateTime?
  color          String?
  microchip      String?
  mark           String?
  comment        String?
  isSterilized   Boolean                    @default(false)
  isFavorite     Boolean                    @default(false)
  status         String?
  weights        AnimalWeightRecord[]
  vaccinations   Vaccination[]
  queueEntries   QueueEntry[]
  appointments   Appointment[]
  visits         Visit[]
  hospitalStays  HospitalStay[]
  tasks          Task[]
  bills          Bill[]
  sales          Sale[]
  notifications  NotificationOutbox[]
  onlineRequests OnlineAppointmentRequest[]
  files          FileObject[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([ownerId])
  @@index([nickname])
  @@index([microchip])
}

model AnimalSpecies {
  id        String        @id @default(uuid())
  code      String        @unique
  title     String        @unique
  sortOrder Int           @default(0)
  breeds    AnimalBreed[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([sortOrder])
}

model AnimalBreed {
  id        String        @id @default(uuid())
  speciesId String
  species   AnimalSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([speciesId, title])
  @@index([speciesId, sortOrder])
  @@index([title])
}

model AnimalWeightRecord {
  id         String   @id @default(uuid())
  animalId   String
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  weightKg   Decimal  @db.Decimal(7, 3)
  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([animalId, measuredAt])
}

model Vaccination {
  id                   String    @id @default(uuid())
  animalId             String
  animal               Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  title                String
  status               String?
  vaccinatedAt         DateTime?
  expiresAt            DateTime?
  vaccineBatch         String?
  vaccineSeries        String?
  vaccineExpiresAt     DateTime?
  smsReminder          Boolean   @default(false)
  ownerReminderEnabled Boolean   @default(false)
  notes                String?
  revaccinationTask    Task?     @relation("VaccinationRevaccinationTask")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([animalId])
  @@index([vaccinatedAt])
  @@index([expiresAt])
}

model QueueEntry {
  id             String        @id @default(uuid())
  officeId       String?
  office         ClinicOffice? @relation(fields: [officeId], references: [id], onDelete: SetNull)
