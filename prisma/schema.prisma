  @@index([supplierId, paidAt])
  @@index([supplyInvoiceId])
  @@index([cashboxId])
  @@index([paymentMethodId])
}

model BusinessCategory {
  id                   String               @id @default(uuid())
  code                 String               @unique
  title                String
  type                 BusinessCategoryType
  groupCode            String
  affectsProfit        Boolean              @default(true)
  administratorAllowed Boolean              @default(false)
  isActive             Boolean              @default(true)
  sortOrder            Int                  @default(0)
  entries              BusinessEntry[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([type, isActive, sortOrder])
}

model BusinessEntry {
  id                 String               @id @default(uuid())
  type               BusinessCategoryType
  status             BusinessEntryStatus  @default(ACTIVE)
  source             BusinessEntrySource  @default(MANUAL)
  categoryId         String
  category           BusinessCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  officeId           String?
  office             ClinicOffice?        @relation(fields: [officeId], references: [id], onDelete: SetNull)
  cashboxId          String?
  cashbox            Cashbox?             @relation(fields: [cashboxId], references: [id], onDelete: SetNull)
  paymentMethodId    String?
  paymentMethod      PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  payrollPeriodId    String?
  payrollPeriod      PayrollPeriod?       @relation(fields: [payrollPeriodId], references: [id], onDelete: SetNull)
  dailyCloseId       String?
  dailyClose         BusinessDailyClose?  @relation(fields: [dailyCloseId], references: [id], onDelete: SetNull)
  amount             Decimal              @db.Decimal(12, 2)
  occurredAt         DateTime
  counterparty       String?
  documentNumber     String?
  comment            String?
  requiresResolution Boolean              @default(false)
  resolvedAt         DateTime?
  resolvedById       String?
  resolvedBy         Employee?            @relation("BusinessEntryResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote     String?
  createdById        String?
  createdBy          Employee?            @relation("BusinessEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  voidedAt           DateTime?
  voidedById         String?
  voidedBy           Employee?            @relation("BusinessEntryVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([occurredAt, status])
  @@index([categoryId, occurredAt])
  @@index([officeId, occurredAt])
  @@index([cashboxId, occurredAt])
  @@index([payrollPeriodId])
  @@index([dailyCloseId])
  @@index([requiresResolution, status])
}

model BusinessDailyClose {
  id             String                   @id @default(uuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  officeId       String
  office         ClinicOffice             @relation(fields: [officeId], references: [id], onDelete: Restrict)
  businessDate   DateTime                 @db.Date
  status         BusinessDailyCloseStatus @default(DRAFT)
  systemIncome   Decimal                  @default(0) @db.Decimal(12, 2)
  systemRefunds  Decimal                  @default(0) @db.Decimal(12, 2)
  systemExpense  Decimal                  @default(0) @db.Decimal(12, 2)
  manualIncome   Decimal                  @default(0) @db.Decimal(12, 2)
  manualExpense  Decimal                  @default(0) @db.Decimal(12, 2)
  expectedAmount Decimal                  @default(0) @db.Decimal(12, 2)
  actualAmount   Decimal                  @default(0) @db.Decimal(12, 2)
  difference     Decimal                  @default(0) @db.Decimal(12, 2)
  comment        String?
  lines          BusinessDailyCloseLine[]
  entries        BusinessEntry[]
  createdById    String?
  createdBy      Employee?                @relation("BusinessDailyCloseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submittedById  String?
  submittedBy    Employee?                @relation("BusinessDailyCloseSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt    DateTime?
  approvedById   String?
  approvedBy     Employee?                @relation("BusinessDailyCloseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([officeId, businessDate])
  @@index([organizationId, businessDate])
  @@index([status, businessDate])
}

model BusinessDailyCloseLine {
  id              String             @id @default(uuid())
  dailyCloseId    String
  dailyClose      BusinessDailyClose @relation(fields: [dailyCloseId], references: [id], onDelete: Cascade)
  lineKey         String
  titleSnapshot   String
  paymentType     PaymentType
  cashboxId       String?
  cashbox         Cashbox?           @relation(fields: [cashboxId], references: [id], onDelete: SetNull)
  paymentMethodId String?
  paymentMethod   PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  systemAmount    Decimal            @default(0) @db.Decimal(12, 2)
  actualAmount    Decimal            @default(0) @db.Decimal(12, 2)
  difference      Decimal            @default(0) @db.Decimal(12, 2)
  comment         String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([dailyCloseId, lineKey])
  @@index([cashboxId])
  @@index([paymentMethodId])
}

model OwnerBalanceOperation {
  id        String      @id @default(uuid())
