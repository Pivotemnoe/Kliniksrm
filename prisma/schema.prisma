  percent   Decimal        @db.Decimal(5, 2)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([profileId, serviceId])
  @@index([serviceId])
}

model PayrollProductRule {
  id        String         @id @default(uuid())
  profileId String
