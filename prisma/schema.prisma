  @@index([periodId, employeeId])
}

model StockDocument {
  id            String              @id @default(uuid())
  number        String?
  type          StockDocumentType
  status        StockDocumentStatus @default(DRAFT)
  warehouseId   String?
  warehouse     Warehouse?          @relation("StockDocumentWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  toWarehouseId String?
  toWarehouse   Warehouse?          @relation("StockDocumentToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  supplierId    String?
  supplier      Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  occurredAt    DateTime            @default(now())
  comment       String?
  createdById   String?
  createdBy     Employee?           @relation("StockDocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  postedById    String?
  postedBy      Employee?           @relation("StockDocumentPoster", fields: [postedById], references: [id], onDelete: SetNull)
  postedAt      DateTime?
  items         StockDocumentItem[]
  movements     StockMovement[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([type, status, occurredAt])
  @@index([warehouseId])
  @@index([toWarehouseId])
  @@index([supplierId])
}

model StockDocumentItem {
  id               String          @id @default(uuid())
  documentId       String
  document         StockDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation("StockDocumentProduct", fields: [productId], references: [id], onDelete: Restrict)
  targetProductId  String?
  targetProduct    Product?        @relation("StockDocumentTargetProduct", fields: [targetProductId], references: [id], onDelete: Restrict)
  sourceBatchId    String?
  sourceBatch      StockBatch?     @relation("StockDocumentSourceBatch", fields: [sourceBatchId], references: [id], onDelete: Restrict)
  targetBatchId    String?
  targetBatch      StockBatch?     @relation("StockDocumentTargetBatch", fields: [targetBatchId], references: [id], onDelete: SetNull)
  expectedQuantity Decimal?        @db.Decimal(12, 3)
  actualQuantity   Decimal?        @db.Decimal(12, 3)
  quantity         Decimal?        @db.Decimal(12, 3)
  unitCost         Decimal?        @db.Decimal(12, 2)
  comment          String?
  movements        StockMovement[]
  createdAt        DateTime        @default(now())

  @@index([documentId])
  @@index([productId])
  @@index([sourceBatchId])
  @@index([targetBatchId])
}

model SupplierPayment {
