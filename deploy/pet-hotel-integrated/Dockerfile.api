ARG BASE_API_IMAGE
FROM ${BASE_API_IMAGE}
ARG RELEASE_REVISION
LABEL org.opencontainers.image.revision=$RELEASE_REVISION
ENV TEMICHEVVET_GIT_COMMIT=$RELEASE_REVISION
COPY prisma /app/prisma
COPY engines/schema-engine-linux-musl-openssl-3.0.x /app/node_modules/@prisma/engines/schema-engine-linux-musl-openssl-3.0.x
RUN mkdir -p /tmp/pet-hotel-integrated-engine \
 && cp /app/node_modules/.prisma/client/libquery_engine-linux-musl-openssl-3.0.x.so.node /tmp/pet-hotel-integrated-engine/query.so.node \
 && chmod 755 /app/node_modules/@prisma/engines/schema-engine-linux-musl-openssl-3.0.x \
 && PRISMA_SCHEMA_ENGINE_BINARY=/app/node_modules/@prisma/engines/schema-engine-linux-musl-openssl-3.0.x PRISMA_QUERY_ENGINE_LIBRARY=/tmp/pet-hotel-integrated-engine/query.so.node /app/node_modules/.bin/prisma generate --schema /app/prisma/schema.prisma
COPY api/ /app/apps/api/dist/
