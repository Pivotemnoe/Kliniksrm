limit_req_zone $binary_remote_addr zone=staff_gateway_general:10m rate=15r/s;
limit_req_zone $binary_remote_addr zone=staff_gateway_login:10m rate=3r/m;

server {
    listen 80;
    listen [::]:80;
    server_name staff.temichevvet.ru;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name staff.temichevvet.ru;

    ssl_certificate /etc/letsencrypt/live/staff.temichevvet.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staff.temichevvet.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 32m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    location ~ ^/api/(auth/login|v1/remote-access/enroll)$ {
        limit_req zone=staff_gateway_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:23000;
        include /etc/nginx/proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-TemichevVet-Remote-Access "1";
        proxy_set_header X-TemichevVet-Gateway-Secret "__REMOTE_ACCESS_GATEWAY_SECRET__";
        proxy_hide_header X-Powered-By;
    }

    location / {
        limit_req zone=staff_gateway_general burst=40 nodelay;
        proxy_pass http://127.0.0.1:23000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-TemichevVet-Remote-Access "1";
        proxy_set_header X-TemichevVet-Gateway-Secret "__REMOTE_ACCESS_GATEWAY_SECRET__";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_hide_header X-Powered-By;
    }
}
