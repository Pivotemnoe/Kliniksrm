NODE_ENV=production
OWNER_GATEWAY_PORT=4100
OWNER_GATEWAY_DATABASE_URL=postgresql://owner_gateway:change-me@127.0.0.1:5434/owner_gateway
OWNER_GATEWAY_PUBLIC_URL=https://cabinet.example.ru
OWNER_GATEWAY_SYNC_SECRET=
# Comma-separated exact origins allowed to send public clinic-site requests.
OWNER_GATEWAY_PUBLIC_SITE_ORIGINS=https://clinic.temichevvet.ru
# Enable only behind a configured trusted reverse proxy.
OWNER_GATEWAY_TRUST_PROXY=false
OWNER_GATEWAY_SESSION_COOKIE=temichevvet_owner_session
OWNER_GATEWAY_SESSION_DAYS=365
OWNER_GATEWAY_TRANSFER_MINUTES=10
OWNER_GATEWAY_VAPID_SUBJECT=mailto:info@temichevvet.ru
OWNER_GATEWAY_VAPID_PUBLIC_KEY=
OWNER_GATEWAY_VAPID_PRIVATE_KEY=
MAX_BOT_NAME=id230210303969_2_bot
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_API_BASE_URL=https://platform-api2.max.ru

# Text chat pilot; existing MAX_BOT_NAME is used unless overridden below.
CLINIC_ASSISTANT_ENABLED=false
CLINIC_ASSISTANT_REMINDERS_ENABLED=false
# Per-owner daily limit; counted in the owner's selected timezone.
CLINIC_ASSISTANT_NOTIFICATION_DAILY_LIMIT=3
# Text intent parsing through the existing NL OpenAI gateway; enable after QA.
CLINIC_ASSISTANT_MODEL_ENABLED=false
CLINIC_ASSISTANT_AUTO_BOOKING_ENABLED=false
CLINIC_ASSISTANT_OPENAI_BASE_URL=
CLINIC_ASSISTANT_OPENAI_GATEWAY_TOKEN=
CLINIC_ASSISTANT_OPENAI_MODEL=gpt-4o-mini
# UTC daily/monthly spending caps, in micro-USD ($1 = 1000000).
CLINIC_ASSISTANT_MODEL_DAILY_MICRO_USD=1000000
CLINIC_ASSISTANT_MODEL_MONTHLY_MICRO_USD=10000000
MAX_BOT_USERNAME=
CLINIC_ASSISTANT_APPROVED_ADDRESS=
CLINIC_ASSISTANT_APPROVED_HOURS=
CLINIC_ASSISTANT_APPROVED_PHONE=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org
NODE_EXTRA_CA_CERTS=/app/certs/russian_trusted_root_ca.pem
