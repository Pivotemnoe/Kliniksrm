generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("OWNER_GATEWAY_DATABASE_URL")
}

model PublicClinicCatalog {
  id         String   @id
  capturedAt DateTime
  receivedAt DateTime @default(now())
  payload    Json
}

enum PortalInviteChannel {
  WEB
  MAX
  TELEGRAM
}

enum PortalInviteStatus {
  ACTIVE
  REDEEMED
  REVOKED
}

enum MessengerChannel {
  MAX
  TELEGRAM
}

enum PortalBookingRequestStatus {
  NEW
  IMPORTED
  CANCELLED
}

enum PublicClinicInquiryStatus {
  NEW
  IMPORTED
  CANCELLED
}

model OwnerSnapshot {
  petHotelOperations PetHotelPortalOperation[]
  groomingOperations GroomingPortalOperation[]
  ownerId           String                   @id
  displayName       String
  payload           Json
  sourceVersion     String
  sourceUpdatedAt   DateTime
  syncedAt          DateTime                 @default(now())
  invitations       PortalInvitation[]
  bindings          MessengerBinding[]
  sessions          PortalSession[]
  pushSubscriptions PortalPushSubscription[]
  bookingRequests   PortalBookingRequest[]
  documents         PortalDocument[]
  conversations     ClinicConversation[]
  notificationPreference OwnerNotificationPreference?
  notificationDeliveries OwnerNotificationDelivery[]

  @@index([syncedAt])
}

// Owner notifications default on; saved opt-outs always take precedence.
model OwnerNotificationPreference {
  ownerId String @id
  owner OwnerSnapshot @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  enabled Boolean @default(true)
  appointmentChanges Boolean @default(true)
  appointmentReminders Boolean @default(true)
  revisitReminders Boolean @default(true)
  vaccinationReminders Boolean @default(true)
  channel MessengerChannel @default(MAX)
  timezone String @default("Europe/Moscow")
  quietStartMinute Int @default(1320)
  quietEndMinute Int @default(480)
  version Int @default(1)
  consentAt DateTime?
  updatedAt DateTime @updatedAt
}

model OwnerNotificationDelivery {
  id String @id
  ownerId String
  owner OwnerSnapshot @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  fingerprint String
  kind String
  status String
  consentVersion Int
  channel MessengerChannel
  dayKey String
  attemptedAt DateTime @default(now())
  completedAt DateTime?
  providerMessageId String?
  error String?
  @@index([ownerId, dayKey, attemptedAt])
  @@index([status, attemptedAt])
}

model PortalDocument {
  id              String        @id @default(uuid())
  ownerId         String
  owner           OwnerSnapshot @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  sourceFileId    String
  animalId        String?
  animalName      String?
  fileName        String
  mimeType        String?
  sizeBytes       Int?
  checksumSha256  String?
  archiveCategory String?
  documentDate    DateTime?
  sourceLabel     String?
  content         Bytes?
  contentStoredAt DateTime?
  sourceCreatedAt DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([ownerId, sourceFileId])
  @@index([ownerId, sourceCreatedAt])
}

model PortalBookingRequest {
  id              String                     @id @default(uuid())
  ownerId         String
  owner           OwnerSnapshot              @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  clientRequestId String
  animalId        String?
  animalNickname  String
  animalSpecies   String?
  preferredAt     DateTime?
  comment         String?
  contactConsent  Boolean
  source          String                     @default("OWNER_PORTAL")
  status          PortalBookingRequestStatus @default(NEW)
  crmRequestId    String?
  importedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([ownerId, clientRequestId])
  @@index([status, createdAt])
  @@index([ownerId, createdAt])
}

model PublicClinicInquiry {
  id              String                    @id @default(uuid())
  clientRequestId String                    @unique
  contactName     String
  phone           String
  animalNickname  String
  message         String
  contactConsent  Boolean
  source          String                    @default("CLINIC_SITE_CHAT")
  status          PublicClinicInquiryStatus @default(NEW)
  crmRequestId    String?
  importedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([phone, createdAt])
}

model PublicClinicAnalyticsEvent {
  id            String   @id @default(uuid())
  eventId       String   @unique
  sessionId     String
  eventName     String
  section       String?
  target        String?
  path          String
  referrerHost  String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  deviceType    String?
  viewportWidth Int?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([eventName, createdAt])
  @@index([sessionId, createdAt])
  @@index([utmSource, createdAt])
}

model PortalInvitation {
  id         String              @id @default(uuid())
  ownerId    String
  owner      OwnerSnapshot       @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  tokenHash  String              @unique
  channel    PortalInviteChannel
  status     PortalInviteStatus  @default(ACTIVE)
  expiresAt  DateTime
  redeemedAt DateTime?
  maxLinkedUserId String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  sessions   PortalSession[]

  @@index([ownerId, status])
  @@index([status, expiresAt])
}

model MessengerBinding {
  id             String           @id @default(uuid())
  ownerId        String
  owner          OwnerSnapshot    @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  channel        MessengerChannel
  externalUserId String
  chatId         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([ownerId, channel])
  @@unique([channel, externalUserId])
}

model PortalSession {
  id                String                   @id @default(uuid())
  ownerId           String
  owner             OwnerSnapshot            @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  inviteId          String?
  invitation        PortalInvitation?        @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  tokenHash         String                   @unique
  expiresAt         DateTime
  lastSeenAt        DateTime                 @default(now())
  revokedAt         DateTime?
  createdAt         DateTime                 @default(now())
  pushSubscriptions PortalPushSubscription[]

  @@index([ownerId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model PortalPushSubscription {
  id            String        @id @default(uuid())
  ownerId       String
  owner         OwnerSnapshot @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  sessionId     String
  session       PortalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  endpoint      String        @unique
  p256dh        String
  auth          String
  userAgent     String?
  failureCount  Int           @default(0)
  lastSuccessAt DateTime?
  disabledAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([ownerId, disabledAt])
  @@index([sessionId])
}

// Website and MAX conversation state lives outside the LAN CRM.
model ClinicConversation {
  id String @id @default(uuid())
  sessionHash String? @unique
  sessionExpiresAt DateTime?
  ownerId String?
  owner OwnerSnapshot? @relation(fields: [ownerId], references: [ownerId], onDelete: SetNull)
  source String @default("SITE_CHAT")
  mode String @default("ASSISTANT")
  needsAttention Boolean @default(false)
  contactName String?
  phone String?
  introductionComplete Boolean @default(false)
  introductionReminded Boolean @default(false)
  animalNickname String?
  preferredAt DateTime?
  contactConsent Boolean @default(false)
  maxUserId String? @unique
  maxConsent Boolean @default(false)
  sequence Int @default(0)
  bookingSequence Int @default(0)
  bookingDraft Json?
  acknowledgedSequence Int @default(0)
  crmRequestId String?
  messages ClinicChatMessage[]
  links ClinicChatLink[]
  bookingOperations ClinicBookingOperation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([needsAttention, updatedAt])
}

// Durable requests are pulled by the LAN CRM; the public gateway never opens the LAN.
model ClinicBookingOperation {
  id String @id @default(uuid())
  conversationId String
  conversation ClinicConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ownerId String
  clientKey String
  kind String
  status String @default("PENDING")
  bookingSequence Int?
  input Json
  result Json?
  error String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@unique([conversationId, clientKey])
  @@index([status, createdAt])
}

model ClinicChatMessage {
  id String @id @default(uuid())
  conversationId String
  conversation ClinicConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sequence Int
  author String
  channel String
  text String
  clientKey String
  deliveryStatus String @default("AVAILABLE")
  providerMessageId String?
  attemptedAt DateTime?
  assistantRun ClinicAssistantRun?
  createdAt DateTime @default(now())
  @@unique([conversationId, clientKey])
  @@unique([conversationId, sequence])
  @@index([deliveryStatus, createdAt])
}

model ClinicAssistantRun {
  id String @id @default(uuid())
  messageId String @unique
  message ClinicChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  status String @default("PENDING")
  model String?
  reservedMicroUsd Int @default(0)
  chargedMicroUsd Int?
  inputTokens Int?
  outputTokens Int?
  intent String?
  errorCode String?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, createdAt])
  @@index([startedAt])
}

model ClinicChatLink {
  tokenHash String @id
  conversationId String
  conversation ClinicConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt DateTime?
}


model GroomingRequest {
  id String @id @default(uuid())
  clientRequestId String @unique
  inputHash String
  contactName String
  phone String
  petName String
  breedId String
  serviceId String
  preferredDate String?
  timeWindow String
  notes String
  looks Json
  consentVersion String
  status String @default("NEW")
  crmRequestId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries GroomingMaxDelivery[]
  @@index([status, createdAt])
}


model GroomingMaxDelivery {
  id String @id @default(uuid())
  requestId String
  request GroomingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recipientId String
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  startedAt DateTime?
  providerMessageId String?
  errorCode String?
  sentAt DateTime?
  @@unique([requestId, recipientId])
  @@index([status, nextAttemptAt])
}


model GroomingPortalOperation {
  id String @id @default(uuid())
  ownerId String
  owner OwnerSnapshot @relation(fields: [ownerId], references: [ownerId], onDelete: Restrict)
  clientKey String
  kind String
  fingerprint String
  input Json
  status String @default("PENDING")
  result Json?
  error String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@unique([ownerId, clientKey])
  @@index([status, createdAt])
}


model GroomingRegistration {
  id String @id @default(uuid())
  tokenHash String @unique
  browserTokenHash String @unique
  input Json
  maxUserId String?
  ownerId String?
  status String @default("WAITING_MAX")
  error String?
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, createdAt])
}


model GroomingStaffDelivery {
  id String @id
  fingerprint String
  recipientId String
  status String
  providerMessageId String?
  attemptedAt DateTime @default(now())
}


model GroomingBookingDraft {
  id String @id @default(uuid())
  tokenHash String @unique
  ipHash String
  payload Json
  consumedByOwnerId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([ipHash, createdAt])
  @@index([expiresAt])
}


model GroomingStorefrontSnapshot {
  id String @id
  payload Json
  fingerprint String
  receivedAt DateTime @default(now())
}


model AvitoAssistantRun {
  id String @id @default(uuid())
  clientKey String @unique
  inputHash String
  direction String
  status String
  model String
  reservedMicroUsd Int
  chargedMicroUsd Int?
  result Json?
  errorCode String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  @@index([createdAt])
}

model PetHotelPortalOperation {
  id String @id @default(uuid())
  ownerId String
  owner OwnerSnapshot @relation(fields: [ownerId], references: [ownerId], onDelete: Restrict)
  clientKey String
  kind String
  fingerprint String
  input Json
  status String @default("PENDING")
  result Json?
  error String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@unique([ownerId, clientKey])
  @@index([status, createdAt])
}
model PetHotelBookingDraft {
  id String @id @default(uuid())
  purpose String
  tokenHash String @unique
  ipHash String
  payload Json
  consumedByOwnerId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([ipHash, createdAt])
  @@index([expiresAt])
}
model PetHotelStorefrontSnapshot {
  id String @id
  payload Json
  fingerprint String
  receivedAt DateTime @default(now())
}
model PetHotelRegistration {
  id String @id @default(uuid())
  tokenHash String @unique
  browserTokenHash String @unique
  input Json
  maxUserId String?
  ownerId String?
  status String @default("WAITING_MAX")
  error String?
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, createdAt])
}

model PetHotelStaffDelivery {
  id String @id
  fingerprint String
  recipientId String
  kind String
  status String
  providerMessageId String?
  attemptedAt DateTime @default(now())
  completedAt DateTime?
  @@index([status, attemptedAt])
}
